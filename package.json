{
  "name": "wathiq",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "واثق: مولد اختبارات علوم Cambridge بسيط، يبدأ من البرنامج والمرحلة والموضوع، مع تأليف حر ومراجعة علمية مستقلة ومرئيات 2D مدققة.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run test",
    "repo:check": "node scripts/check-repository-hygiene.mjs",
    "repo:clean": "node scripts/check-repository-hygiene.mjs --clean"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/physicsbasit-debug/wathiq.git"
  }
}
