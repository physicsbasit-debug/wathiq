{
  "name": "wathiq",
  "version": "0.0.68",
  "private": true,
  "type": "module",
  "description": "واثق: منصة لإعداد اختبارات مواد العلوم من مصادر موثقة، بخطة تقويم حتمية وتوليد تدريجي دائم وتحقيق علمي ومرئي وتصدير Word/PDF.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run test",
    "repo:check": "node scripts/check-repository-hygiene.mjs",
    "d4:check": "node scripts/check-phase-3-0-readiness.mjs",
    "repo:clean": "node scripts/check-repository-hygiene.mjs --clean"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/physicsbasit-debug/wathiq.git"
  }
}
