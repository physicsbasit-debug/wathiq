{
  "name": "wathiq",
  "version": "0.3.18",
  "private": true,
  "type": "module",
  "description": "واثق: مرئيات علمية غير رقمية كصور 2D مدققة، مع اقتلاع مولد الرسوم التخطيطية القديم والإبقاء على الجداول والرسوم البيانية العددية الحتمية.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run repo:check && npm run legacy:check && npm run runtime:check && npm run ui:check && npm run test",
    "repo:check": "node scripts/check-repository-hygiene.mjs",
    "repo:clean": "node scripts/check-repository-hygiene.mjs --clean",
    "ui:check": "node scripts/check-arabic-rtl.mjs",
    "legacy:check": "node scripts/check-anti-legacy.mjs",
    "runtime:check": "node scripts/check-runtime-integrity.mjs"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/physicsbasit-debug/wathiq.git"
  }
}
